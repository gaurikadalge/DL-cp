# ==============================================================================
# Multimodal RAG Research Assistant - Environment Configuration Template
# Copy this file to '.env' for local development:
#   cp .env.example .env
# Never commit '.env' containing real secrets or private credentials to git.
# ==============================================================================

# --- Application Core Settings ---
APP_NAME="Multimodal RAG Research Assistant"
APP_ENV=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# --- Metadata Storage (SQLite for rapid prototype; PostgreSQL for persistent deployment) ---
DATABASE_URL=sqlite:///./data/research_assistant.db

# --- Ingestion & Upload Safeguards ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf"]
STORAGE_DIR=./data/uploads

# --- Retrieval & Vector Index Settings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_PATH=./indexes
OCR_ENABLED=false
RERANKER_ENABLED=false
TOP_K_DENSE=10
TOP_K_BM25=10
TOP_K_FINAL=5

# --- LLM Provider Configuration (Grounded Answer Generation) ---
# Supported providers: 'openai', 'anthropic', 'ollama', 'groq', or mock
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
